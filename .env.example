# Copy this file to ".env" in the same folder as app.py, then fill in real values.

# Production web server (Waitress + Windows service):
#   pip install -r requirements.txt
#   python serve.py                                    # foreground test
#   powershell -File scripts\install_waitress_logon_task.ps1  # no admin (starts at logon)
#   powershell -File scripts\install_waitress_service.ps1     # admin: true Windows service
# FLASK_ENV=production
# WAITRESS_HOST=127.0.0.1
# WAITRESS_PORT=5001
# WAITRESS_THREADS=8
# PLANNER_POOL_MIN=1
# PLANNER_POOL_MAX=6

# ERP sync: weekdays at 08:00 and 13:00 via scripts/install_erp_sync_scheduler.ps1 (Windows Task Scheduler).
# After sync, the running Flask app is notified to refresh in-process list/count caches.
# PLANNER_BASE_URL=http://127.0.0.1:5001
# ERP_CACHE_REFRESH_SECRET=optional-shared-secret-for-remote-notify
# Keep these off unless you explicitly want extra in-app sync (adds Supabase egress):
# ENABLE_AUTO_SYNC=0
# PP_VOUCHERS_AUTO_SYNC_ON_READ=0
# Catalog (/api/pp-vouchers/with-ops) is pre-built during ERP sync — not on page load.
# Disk cache: cache/pp_vouchers_with_ops/  |  Full enrich: PP_VOUCHERS_CATALOG_FULL=1
# Report routes read Supabase staging by default. Set ERP_LIVE_READ=1 to force live COMAIN for all.
# These screens always read live COMAIN regardless: New Orders, S/O Management, Delivery Schedule,
# Inventory Enquiry, Inventory BOM, BOM Variation, Material Inspection.
# ERP_LIVE_READ=0
# Shared file cache across Flask workers (same host): cache/erp_routes/
# ERP_ROUTE_CACHE_DIR=cache/erp_routes
# ERP_ROUTE_CACHE_TTL_SEC=300

# Passcode typed at https://your-domain/ before opening /planner
PLANNER_PASSCODE=change-me-to-your-team-code

# Optional: separate passcode gating all REPORTS / ANALYTICS tabs
# (Sales report, Job ratio report, Machine capacity, Repeat orders).
# Leave unset/blank to keep those tabs open. When set, users must enter this
# passcode before opening any report page or its /api data endpoints.
# REPORTS_PASSCODE=change-me-to-your-reports-code

# Random string for session cookies — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional: shop-floor board URL (default /machine-queue, no passcode required)
# MACHINIST_BOARD_PATH=/machine-queue

# Optional: QAQC / post-machining queue URL (default /qaqc-view, no passcode required)
# FINISHING_QUEUE_PATH=/qaqc-view

# Optional: driver delivery schedule URL (default /driver-view, no passcode required)
# DRIVER_VIEW_PATH=/driver-view

# Auk Industries live OEE dashboard (/auk-oee)
# AUK_ACCESS_TOKEN=your-jwt-from-ops.auk.industries-local-storage
# AUK_ENTITY_ID=383
# AUK_PARETO_BLOCK_ID=5462
# AUK_DATA_SOURCE=pareto
# AUK_API_BASE=https://api.prod.auk.industries/v1
# AUK_FRONTEND_URL=https://ops.auk.industries/pareto_analysis/5462
# AUK_SKU_OEE=false
# Legacy canvas tiles (only if AUK_DATA_SOURCE=canvas):
# AUK_CANVAS_ID=426

# Aker Inventory — local Excel workbook (GET /api/local-excel, /planning-data/aker-inventory)
# Supports .xls (xlrd) and .xlsx/.xlsm (openpyxl). Leave LOCAL_EXCEL_SHEET unset for all sheets.
# LOCAL_EXCEL_PATH=Z:\MaterialStore\ShareDoc\Material\2 Aker Material.xls
# LOCAL_EXCEL_SHEET=Sheet1
# LOCAL_EXCEL_ALL_SHEETS=1
